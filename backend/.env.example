# Configuration Anthropic Claude (obligatoire pour des réponses de qualité)
# Créez une clé sur : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TEMPERATURE=0.4

# Limites de tokens par type de requête
MAX_TOKENS_CHAT=1600
MAX_TOKENS_EXERCISE=1800
MAX_TOKENS_SIMPLIFY=900

# Mémoire de conversation (nombre d'échanges conservés)
HISTORY_MAX_TURNS=6

# ChromaDB (base vectorielle locale du RAG)
CHROMA_PERSIST_DIR=./data/chroma_db

# Serveur applicatif
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Comptes élèves (optionnel) : base SQLite + secret de signature des tokens de connexion.
# Si JWT_SECRET est laissé vide, un secret est généré automatiquement au premier démarrage
# et sauvegardé dans data/.jwt_secret (à ne jamais partager ni committer).
DB_PATH=./data/app.db
JWT_SECRET=
JWT_EXPIRE_DAYS=30
