# Copiez ce fichier en `.env` (jamais commité, voir .gitignore) et renseignez les valeurs.

# Configuration Anthropic Claude (obligatoire pour des réponses de qualité)
# Créez une clé sur : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TEMPERATURE=0.4

# Base Postgres + pgvector (Neon) DÉDIÉE à la chimie : index vectoriel des cours ET données
# applicatives (comptes élèves, conversations, schéma "app"). Ne jamais réutiliser la base de
# l'application de maths ni celle de physique : ingest_documents.py supprime puis reconstruit la
# table vectorielle. Connexion directe (sans "-pooler" dans l'hôte), avec ?sslmode=require.
DATABASE_URL=
VECTOR_TABLE_NAME=chimie_burkina_embeddings

# Mémoire de conversation (nombre d'échanges conservés)
HISTORY_MAX_TURNS=6

# Serveur applicatif
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret de signature des tokens de connexion. Laissé vide en développement : un secret est
# généré automatiquement dans data/.jwt_secret (jamais commité). Obligatoire si APP_ENV=production.
JWT_SECRET=
JWT_EXPIRE_DAYS=7
