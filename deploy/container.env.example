# Variables d'environnement du conteneur, à placer sur le serveur dans ~/<app>/container.env
# (droits 600, jamais commité). Généré automatiquement par :
#   .\deploy\preparer_archive.ps1 -App <app> -AvecSecrets
# Une ligne par variable, sans guillemets ni espaces autour du « = » (format docker --env-file).

# Clé API Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Base Neon DÉDIÉE à l'application (chimie et physique ont chacune la leur) : connexion directe,
# sans « -pooler » dans l'hôte, avec ?sslmode=require.
DATABASE_URL=
# chimie : chimie_burkina_embeddings ; physique : physique_burkina_embeddings
VECTOR_TABLE_NAME=

# Production : le backend refuse de démarrer sans JWT_SECRET explicite. Générer une fois pour toutes
# (le changer déconnecte tous les élèves) : openssl rand -base64 48
APP_ENV=production
JWT_SECRET=
JWT_EXPIRE_DAYS=7
HISTORY_MAX_TURNS=6
